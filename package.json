{
  "name": "thought-atlas",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "workspaces": [
    "packages/core",
    "packages/daemon",
    "packages/adapters/codex",
    "packages/adapters/watcher",
    "packages/adapters/qoder",
    "packages/web"
  ],
  "scripts": {
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p packages/web/tsconfig.json",
    "test": "node --test packages/core/test/*.test.ts packages/adapters/codex/test/*.test.ts packages/adapters/watcher/test/*.test.ts packages/adapters/qoder/test/*.test.ts packages/daemon/test/*.test.ts packages/web/test/*.test.ts",
    "d1:synthetic": "node scripts/d1-synthetic.ts",
    "build:web": "npm run build --workspace packages/web"
  },
  "devDependencies": {
    "@types/d3-force": "^3.0.10",
    "@types/node": "^24.0.0",
    "esbuild": "^0.28.2",
    "typescript": "^5.9.0"
  }
}

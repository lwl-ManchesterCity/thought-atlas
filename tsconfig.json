{
  "compilerOptions": {
    "target": "es2023",
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "lib": ["es2023"],
    "strict": true,
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "erasableSyntaxOnly": true,
    "verbatimModuleSyntax": true,
    "skipLibCheck": true,
    "types": ["node"]
  },
  "include": [
    "packages/core/src/**/*.ts",
    "packages/core/test/**/*.ts",
    "packages/daemon/src/**/*.ts",
    "packages/daemon/test/**/*.ts",
    "packages/adapters/codex/src/**/*.ts",
    "packages/adapters/codex/test/**/*.ts",
    "packages/adapters/watcher/src/**/*.ts",
    "packages/adapters/watcher/test/**/*.ts",
    "packages/adapters/qoder/src/**/*.ts",
    "packages/adapters/qoder/test/**/*.ts",
    "scripts/**/*.ts"
  ]
}
{
  "compilerOptions": {
    "target": "es2023",
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "lib": ["es2023", "dom", "dom.iterable"],
    "strict": true,
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "erasableSyntaxOnly": true,
    "verbatimModuleSyntax": true,
    "skipLibCheck": true,
    "types": ["node"],
    "baseUrl": ".",
    "paths": {
      "@thought-atlas/core": ["../functions/lib/core/index.ts"]
    }
  },
  "include": [
    "functions/lib/**/*.ts",
    "dev/**/*.ts",
    "test/**/*.ts",
    "web/**/*.ts",
    "../scripts/sample-gate.ts"
  ],
  "exclude": ["functions/index.ts"]
}